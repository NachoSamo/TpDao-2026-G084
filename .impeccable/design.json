  "narrative": {
    "northStar": "Señalética de distribución",
    "overview": "Andén toma la señalética de distribución como mundo visual: superficies claras, verde bosque, tipografía Rubik local y trazos precisos. La jerarquía se construye con espaciado y peso; no usa imágenes decorativas ni indicadores inventados.\n\nLa interfaz es compacta y operativa. Los estados tienen nombre además de color, las acciones explicitan su destino y los datos de demostración permanecen identificados, incluso en móvil. La elección confirmada del usuario es un tablero de bultos y estados construido directamente en código; esa primera pantalla no obliga a convertir otras vistas en tableros.",
    "keyCharacteristics": [
      "Superficies de tiza y salvia con acciones en bosque.",
      "Rubik regular y bold, números tabulares en tablas.",
      "Detalle y transición como controles independientes."
    ],
    "rules": [
      {
        "name": "Estado legible",
        "body": "Cada estado lleva un nombre visible; el color acompaña y no reemplaza esa información.",
        "section": "colors"
      },
      {
        "name": "Jerarquía por peso",
        "body": "Usar Rubik regular para lectura y bold para títulos e identificadores; sostener la jerarquía con espacio antes de agregar decoración.",
        "section": "typography"
      },
      {
        "name": "Plano operativo",
        "body": "Las superficies de trabajo se separan por tono y bordes; las sombras quedan para el diálogo y la notificación superpuesta.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do mantener labels visibles, foco visible y enlace de salto.",
      "Do mostrar carga, éxito y error cerca de la operación, con errores dentro del formulario.",
      "Do conservar nombres de estados, acciones explícitas y señal de demo visible.",
      "Do respetar reduced-motion y el scroll propio de tablero y tablas."
    ],
    "donts": [
      "Don't agregar imágenes decorativas ni métricas inventadas.",
      "Don't unir apertura del detalle y transición en un único control.",
      "Don't ofrecer drag-and-drop que omita las reglas de State."
    ]
  }
